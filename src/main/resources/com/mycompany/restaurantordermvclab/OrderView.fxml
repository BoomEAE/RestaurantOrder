<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="350.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.restaurantordermvclab.OrderViewController">
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="File">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onPlaceOrder" text="Place Order" />
                  <MenuItem mnemonicParsing="false" onAction="#onClearOrder" text="Clear Order" />
                  <MenuItem mnemonicParsing="false" onAction="#onExit" text="Exit" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Edit">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onClearEntree" text="Entrée" />
                  <MenuItem mnemonicParsing="false" onAction="#onClearDrink" text="Drink" />
                  <MenuItem mnemonicParsing="false" onAction="#onClearSpecialRequest" text="Special Request" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Help">
            <items>
              <MenuItem mnemonicParsing="false" onAction="#onAbout" text="About" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" BorderPane.alignment="CENTER">
         <children>
            <HBox prefWidth="200.0" spacing="20.0">
               <children>
                  <VBox prefWidth="300.0">
                     <children>
                        <Label maxWidth="1.7976931348623157E308" style="-fx-background-color: grey;" text="Entrée Selection" />
                        <ListView fx:id="entreeListView" prefHeight="120.0" prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" spacing="10.0" style="-fx-background-color: white;">
                     <children>
                        <Label maxWidth="1.7976931348623157E308" style="-fx-background-color: grey;" text="Drink Selection" />
                        <VBox prefWidth="100.0" spacing="10.0">
                           <children>
                              <RadioButton fx:id="coffeeRadioBtn" mnemonicParsing="false" text="Coffee" />
                              <RadioButton fx:id="teaRadioBtn" mnemonicParsing="false" text="Tea" />
                              <RadioButton fx:id="sodaRadioBtn" mnemonicParsing="false" text="Soda" />
                              <RadioButton fx:id="juiceRadioBtn" mnemonicParsing="false" text="Juice" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <CheckBox fx:id="requestFreeWaterBox" mnemonicParsing="false" onAction="#onRequestFreeWater" text="Request Free Water" />
            <VBox prefWidth="100.0" style="-fx-background-color: grey;">
               <children>
                  <Label text="Special Requests" />
                  <TextField fx:id="specialRequestField" promptText="e.g. Hold the onion" />
               </children>
            </VBox>
            <HBox prefHeight="100.0" prefWidth="200.0" spacing="210.0">
               <children>
                  <VBox prefHeight="200.0" prefWidth="140.0">
                     <children>
                        <Label text="Current Order : " underline="true">
                           <font>
                              <Font size="15.0" />
                           </font></Label>
                        <Label fx:id="totalLabel" text="Total : $0.00" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER" prefHeight="100.0" prefWidth="300.0" spacing="20.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#onPlaceOrder" prefWidth="100.0" text="Place Order" />
                        <Button mnemonicParsing="false" onAction="#onClearOrder" prefWidth="100.0" text="Clear Order" />
                     </children>
                  </HBox>
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
